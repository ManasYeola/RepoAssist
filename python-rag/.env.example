# Database (same Neon PostgreSQL as Node.js backend)
DATABASE_URL=postgresql://username:password@ep-xxx.neon.tech/repogpt?sslmode=require

# Google Gemini (Used for LLM Chat generation)
GEMINI_API_KEY=your_gemini_api_key

# Node.js backend URL (for CORS allowlist)
NODE_BACKEND_URL=http://localhost:3000

# Optional: HuggingFace Local Embedding Model (Defaults to 768-dim all-mpnet-base-v2)
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
